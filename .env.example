# GitHub App
GITHUB_APP_ID=
# PEM contents. Use \n for newlines, or set GITHUB_APP_PRIVATE_KEY_PATH instead.
GITHUB_APP_PRIVATE_KEY=
# Docker Compose + install.sh mount the key at this path (see github-app.pem).
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
# Optional. Used only for display / docs, e.g. maomao
GITHUB_APP_SLUG=

# Authorization (numeric GitHub node IDs — not owner/repo names)
# Account/org/user ids from installation.account.id. Empty = unrestricted on this axis.
# ALLOWED_GITHUB_ACCOUNT_IDS=123456
# Repository ids from repository.id. Empty = unrestricted on this axis.
# ALLOWED_GITHUB_REPOSITORY_IDS=987654321
# Per-repository enqueue limit (0 disables). Window is milliseconds.
# REPO_RATE_LIMIT_PER_WINDOW=6
# REPO_RATE_WINDOW_MS=3600000
# Reject diffs larger than this many bytes before OpenCode (0 disables). Default 1 MiB.
# MAX_DIFF_BYTES=1048576

# OpenCode worker
# Docker Compose sets OPENCODE_BIN to the binary on volume maomao-opencode.
OPENCODE_BIN=opencode
# provider/model, e.g. anthropic/claude-sonnet-4-5 or openai/gpt-4.1
OPENCODE_REVIEWER_MODEL=
# Optional. Defaults to OPENCODE_REVIEWER_MODEL
OPENCODE_AGGREGATOR_MODEL=
OPENCODE_TIMEOUT_MS=600000
# Capped at 5. Each specialist run is attempt 1 + this many retries.
OPENCODE_MAX_RETRIES=1
OPENCODE_REVIEWER_CONCURRENCY=2
# Extra CLI args, comma-separated
# OPENCODE_EXTRA_ARGS=
# Pin the CLI seeded into volume maomao-opencode by scripts/install.sh
# (omit to use the latest GitHub release). Recreating the container does not
# download a new CLI — re-seed with ./scripts/install.sh --upgrade-opencode.
# OPENCODE_VERSION=

# Reviewer roles (comma-separated ids). Defaults:
# correctness,security,tests,architecture,api,maintainer
# REVIEWER_ROLES=correctness,security,tests,architecture,api,maintainer
# Optional per-role overrides:
# REVIEWER_MODEL_SECURITY=anthropic/claude-opus-4-6
# REVIEWER_PROMPT_SECURITY=...

# Service
HOST=0.0.0.0
PORT=3000
# Host port published by Docker Compose (container still listens on PORT).
# MAOMAO_PORT=3000
# Printed by install.sh as the webhook / UI base URL.
# MAOMAO_PUBLIC_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/maomao.sqlite
WORKSPACE_ROOT=./data/workspaces
# Docker Compose overrides the two paths above to /data on volume maomao-data.
WORKSPACE_RETENTION_HOURS=24
JOB_CONCURRENCY=1
LOG_LEVEL=info

# Behavior
REVIEW_DRAFTS=false
POST_EMPTY_REVIEW=false
PULL_REQUEST_ACTIONS=opened,reopened,synchronize,ready_for_review
MAX_INLINE_COMMENTS=12

# Optional UI session gate. Webhook + /health stay public.
# Leave both unset for an open local/dev UI. Production must set both
# before exposing Maomao beyond localhost. scripts/install.sh always sets both.
# UI_PASSWORD=
# UI_SESSION_SECRET=
# Aliases: MAOMAO_UI_PASSWORD, MAOMAO_UI_SESSION_SECRET

# Provider credentials for OpenCode (examples — use whatever your OpenCode setup needs).
# Only keys matching Maomao's provider allowlist are copied into OpenCode children.
# AWS_/BEDROCK_/VERTEX_ prefixes are included for BYO cloud models — do not run
# Maomao on a host whose process environment holds unrelated cloud credentials.
# Never bake these into the image; they belong in .env (or a secret mount).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
