# GitHub App
GITHUB_APP_ID=
# PEM contents. Use \n for newlines, or set GITHUB_APP_PRIVATE_KEY_PATH instead.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
# Optional. Used only for display / docs, e.g. maomao
GITHUB_APP_SLUG=

# OpenCode worker
OPENCODE_BIN=opencode
# provider/model, e.g. anthropic/claude-sonnet-4-5 or openai/gpt-4.1
OPENCODE_REVIEWER_MODEL=
# Optional. Defaults to OPENCODE_REVIEWER_MODEL
OPENCODE_AGGREGATOR_MODEL=
OPENCODE_TIMEOUT_MS=600000
OPENCODE_MAX_RETRIES=1
OPENCODE_REVIEWER_CONCURRENCY=2
# Extra CLI args, comma-separated
# OPENCODE_EXTRA_ARGS=

# Reviewer roles (comma-separated ids). Defaults:
# correctness,security,tests,architecture,api,maintainer
# REVIEWER_ROLES=correctness,security,tests,architecture,api,maintainer
# Optional per-role overrides:
# REVIEWER_MODEL_SECURITY=anthropic/claude-opus-4-6
# REVIEWER_PROMPT_SECURITY=...

# Service
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/maomao.sqlite
WORKSPACE_ROOT=./data/workspaces
WORKSPACE_RETENTION_HOURS=24
JOB_CONCURRENCY=1
LOG_LEVEL=info

# Behavior
REVIEW_DRAFTS=false
POST_EMPTY_REVIEW=false
PULL_REQUEST_ACTIONS=opened,reopened,synchronize,ready_for_review
MAX_INLINE_COMMENTS=12

# Optional UI gate (webhook + /health stay public)
# UI_BASIC_AUTH_USER=
# UI_BASIC_AUTH_PASSWORD=

# Provider credentials for OpenCode (examples — use whatever your OpenCode setup needs)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
